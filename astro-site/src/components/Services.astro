---
import { services } from '../data/site';
import { icons } from './icons';
---
<section id="about" style="padding:70px 40px;max-width:1360px;margin:0 auto">
  <div style="margin-bottom:36px">
    <div style="color:var(--accent);font-weight:700;font-size:13px;letter-spacing:1px;margin-bottom:8px">О НАС</div>
    <h2 style="font-size:34px;font-weight:700;margin:0">Профессиональный ремонт и обслуживание мото- и авто-техники</h2>
  </div>
  <div id="services" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px">
    {services.map((s) => (
      <div style="background:#1a1a1d;border:1px solid #26262a;border-radius:14px;padding:26px">
        <div style="width:46px;height:46px;border-radius:10px;background:#232326;display:flex;align-items:center;justify-content:center;margin-bottom:16px;color:var(--accent)" set:html={icons[s.icon]} />
        <div class="oswald" style="font-weight:600;font-size:18px;margin-bottom:8px">{s.title}</div>
        <div style="color:#9b9a97;font-size:14.5px;line-height:1.55">{s.desc}</div>
      </div>
    ))}
  </div>
</section>

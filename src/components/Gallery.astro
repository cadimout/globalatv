---
import { galleryIds } from '../data/site';
---
<section id="portfolio" style="padding:20px 40px 70px;max-width:1360px;margin:0 auto">
  <div style="color:var(--accent);font-weight:700;font-size:13px;letter-spacing:1px;margin-bottom:8px">ФОТОГАЛЕРЕЯ</div>
  <h2 style="font-size:30px;font-weight:700;margin:0 0 28px">Наши работы</h2>
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px">
    {galleryIds.map((id) => (
      <div style="aspect-ratio:1;border-radius:12px;overflow:hidden;background:var(--card-bg);border:1px solid var(--card-border);display:flex;align-items:center;justify-content:center;color:var(--text-footer);font-size:13px">
        {/* замените на <img src={`/images/${id}.jpg`} alt="Фото работы" /> */}
        Фото работы
      </div>
    ))}
  </div>
</section>

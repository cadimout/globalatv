---
import { brands } from '../data/site';
---
<section style="padding:60px 40px;max-width:1360px;margin:0 auto">
  <div style="color:var(--accent);font-weight:700;font-size:13px;letter-spacing:1px;margin-bottom:8px">ПАРТНЁРЫ И БРЕНДЫ</div>
  <h2 style="font-size:30px;font-weight:700;margin:0 0 28px">Всегда в наличии</h2>
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:18px">
    {brands.map((b) => (
      <div style="background:var(--card-bg);border:1px solid var(--card-border);border-radius:14px;padding:22px">
        <div class="oswald" style="font-weight:700;font-size:17px;margin-bottom:10px">{b.name}</div>
        <div style="color:var(--text-dim);font-size:13.5px;line-height:1.55">{b.desc}</div>
      </div>
    ))}
  </div>
</section>

---
// Бесплатный чат-помощник. Фронтенд шлёт запрос на /api/chat — это серверная функция,
// GitHub Pages её не выполнит (только статика), поэтому задеплойте api/chat отдельно
// на Vercel/Netlify Functions/Cloudflare Worker и укажите его URL в data-endpoint ниже.
---
<div id="ai-chat" data-endpoint="/api/chat" style="position:fixed;bottom:24px;right:24px;z-index:100">
  <div id="ai-panel" style="display:none;width:340px;height:440px;background:#1a1a1d;border:1px solid #26262a;border-radius:16px;box-shadow:0 20px 50px rgba(0,0,0,.5);flex-direction:column;overflow:hidden;margin-bottom:14px">
    <div style="background:var(--accent);padding:16px 18px;display:flex;justify-content:space-between;align-items:center">
      <div>
        <div class="oswald" style="font-weight:700;color:#141416;font-size:15px">AI-помощник</div>
        <div style="font-size:11.5px;color:#3a2210">Бесплатная консультация</div>
      </div>
      <div id="ai-close" style="cursor:pointer;color:#141416;font-size:20px;font-weight:700;line-height:1">×</div>
    </div>
    <div id="ai-messages" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;color:#eceae6;font-size:13.5px"></div>
    <div style="padding:12px;border-top:1px solid #26262a;display:flex;gap:8px">
      <input id="ai-input" placeholder="Опишите неисправность…" style="flex:1;background:#232326;border:1px solid #2e2e32;border-radius:8px;padding:10px 12px;color:#eceae6;font-size:13.5px;outline:none" />
      <div id="ai-send" style="background:var(--accent);color:#141416;width:38px;height:38px;border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-weight:700">→</div>
    </div>
  </div>
  <div id="ai-toggle" style="width:58px;height:58px;border-radius:29px;background:var(--accent);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 10px 30px rgba(255,106,26,.4);font-size:26px">🛠️</div>
</div>

<script>
  const root = document.getElementById('ai-chat')!;
  const endpoint = root.dataset.endpoint!;
  const panel = document.getElementById('ai-panel')!;
  const messages = document.getElementById('ai-messages')!;
  const input = document.getElementById('ai-input') as HTMLInputElement;
  const history: { role: 'user' | 'assistant'; content: string }[] = [];

  function addBubble(text: string, mine: boolean) {
    const div = document.createElement('div');
    div.style.cssText = `max-width:85%;align-self:${mine ? 'flex-end' : 'flex-start'};background:${mine ? 'var(--accent)' : '#232326'};color:${mine ? '#141416' : '#eceae6'};padding:10px 14px;border-radius:12px;line-height:1.5;white-space:pre-wrap`;
    div.textContent = text;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  addBubble('Здравствуйте! Я бесплатный AI-помощник Global-ATV. Опишите проблему с мотоциклом, квадроциклом или снегоходом — подскажу возможную причину. Точную диагностику и ремонт сделают наши мастера в сервисе.', false);

  document.getElementById('ai-toggle')!.addEventListener('click', () => {
    panel.style.display = panel.style.display === 'flex' ? 'none' : 'flex';
  });
  document.getElementById('ai-close')!.addEventListener('click', () => (panel.style.display = 'none'));

  async function send() {
    const text = input.value.trim();
    if (!text) return;
    addBubble(text, true);
    history.push({ role: 'user', content: text });
    input.value = '';
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });
      const data = await res.json();
      addBubble(data.reply, false);
      history.push({ role: 'assistant', content: data.reply });
    } catch (e) {
      addBubble('Не получилось получить ответ. Позвоните нам: +7 (926) 388-28-90.', false);
    }
  }
  document.getElementById('ai-send')!.addEventListener('click', send);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') send(); });
</script>
